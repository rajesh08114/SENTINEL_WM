# ---------------------------------------------------------------------------
# SENTINEL-WM  .gitignore
# ---------------------------------------------------------------------------

# --- generated pipeline working files (rebuilt by `python -m sentinel_wm.cli all`)
artifacts/*
!artifacts/.gitkeep

# --- runs/ : generated benchmark study (renamed from ./research/). Commit the
#     PROOF (reports, benchmark CSVs, figures, meta, registry, logs); ignore the
#     regenerable heavy binaries.
runs/models/**/*.pkl
runs/models/**/*.pt
runs/simulations/forward_sim_test.json
runs_zeroshot/

# --- the deploy bundle (`sentinel-wm bundle`) - regenerable model binaries.
#     Its canonical home is backend/models/ (shipped inside the backend).
/models/
backend/models/

# --- backend / frontend runtime
backend/data/
backend/.env
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/playwright-report/
frontend/test-results/
capture-agent/*.egg-info/
*.sqlite
*.sqlite3
*.db

# --- datasets (too large / redistribution-restricted; see data/README.md)
data/*
!data/README.md
*.pcap
*.pcapng
*.parquet
*.npz

# --- Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg
pip-wheel-metadata/

# --- virtual environments
.venv/
venv/
env/
ENV/
.python-version

# --- Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile_default/
ipython_config.py

# --- tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- misc
tshark_tmp/
tmp_pcap/
*.log
