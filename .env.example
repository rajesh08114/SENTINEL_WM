# Root env for docker compose. Backend-specific vars live in backend/.env.example.
COMPOSE_PROJECT_NAME=sentinel-wm

# where the model bundle is on the host (mounted read-only into the backend)
MODELS_DIR=./backend/models

# backend
SENTINEL_DEVICE=cpu
SENTINEL_WORKERS=2
SENTINEL_MAX_SYNC_FLOWS=20000
SENTINEL_CORS_ORIGINS=*
SENTINEL_LIVE_MAX_SESSIONS=4
SENTINEL_LIVE_IDLE_TIMEOUT_S=900
SENTINEL_SYNTH_MAX_RATE=500
SENTINEL_AGENT_ENABLED=true
SENTINEL_LOG_JSON=false
SENTINEL_METRICS=false

# frontend (build-time fallback; runtime override via topbar / ?api= / localStorage)
NEXT_PUBLIC_API_BASE=http://localhost:8000
