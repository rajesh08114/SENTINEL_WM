# Root env for docker compose. Backend-specific vars live in backend/.env.example.
COMPOSE_PROJECT_NAME=sentinel-wm

# where the model bundle is on the host (mounted read-only into the backend)
MODELS_DIR=./models

# backend
SENTINEL_DEVICE=cpu
SENTINEL_WORKERS=2
SENTINEL_MAX_SYNC_FLOWS=20000
SENTINEL_CORS_ORIGINS=*

# frontend (Phase 4)
NEXT_PUBLIC_API_URL=http://localhost:8000
