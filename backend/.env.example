# --- SENTINEL-WM backend configuration -------------------------------------
# Path to the model bundle produced by `sentinel-wm bundle` (research/).
# In docker-compose this is the mounted volume /models.
SENTINEL_WM_MODEL_DIR=../models

# inference device: cpu | cuda
SENTINEL_DEVICE=cpu

# which model to serve:
#   auto        - SENTINEL-WM (system) blend if the bundle has tcn/lstm/gru, else world model
#   system      - force the blend (errors down to world_model if members missing)
#   world_model - the raw world model only (skips loading the 3 member nets)
SENTINEL_SERVE_MODE=auto

# CSV uploads with <= this many flows are scored synchronously; larger -> a job
SENTINEL_MAX_SYNC_FLOWS=20000
SENTINEL_PCAP_MAX_BYTES=60000000

# Monte-Carlo rollout samples per anchor (higher = tighter CIs, slower)
SENTINEL_MC_SAMPLES=50

# background worker threads for jobs + streaming inference
SENTINEL_WORKERS=2

# where job status (SQLite) and result JSON are written
SENTINEL_JOB_DIR=./data/jobs

# telemetry stream: seconds to wait past a window boundary before scoring it
SENTINEL_STREAM_GRACE_SECONDS=3.0

# comma-separated allowed CORS origins for the frontend (use * for local dev)
SENTINEL_CORS_ORIGINS=*
